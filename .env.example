# Frontend (públicas — podem ir ao navegador)
SITE_URL=http://localhost:3000

# Supabase — configure no Supabase Secrets (Edge Functions), nunca em NEXT_PUBLIC_*
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# MercosulPay (PIX) — backend apenas
MERCOSULPAY_API_URL=https://mercosulpay.com/api/public/v1
MERCOSULPAY_API_KEY=
MERCOSULPAY_WEBHOOK_SECRET=

# URL pública das Edge Functions para o frontend chamar create-order / order-status
# Ex.: https://<project-ref>.supabase.co/functions/v1
SUPABASE_FUNCTIONS_URL=
